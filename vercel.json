{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.unitcore.io" }],
      "destination": "https://unitcore.io/",
      "permanent": true
    },
    {
      "source": "/:path+",
      "has": [{ "type": "host", "value": "www.unitcore.io" }],
      "destination": "https://unitcore.io/:path+",
      "permanent": true
    }
  ]
}
